 "html": "<div style=\"\n    width: 720px;\n    margin: 0 auto;\n    font-family: Arial, Helvetica, sans-serif;\n    color: #222;\n    background: #fff;\n    border: 1px solid #d9d9d9;\n    border-radius: 12px;\n    overflow: hidden;\n\">\n\n    <!-- HEADER -->\n    <div style=\"\n        padding: 22px 28px;\n        border-bottom: 1px solid #ddd;\n    \">\n        <table style=\"width: 100%; border-collapse: collapse;\">\n            <tr>\n                <td style=\"width: 60%; vertical-align: middle;\">\n                    <div style=\"font-size: 26px; font-weight: bold; letter-spacing: 2px;\">\n                        AIRSTAR\n                    </div>\n                    <div style=\"font-size: 11px; color: #777; margin-top: 4px;\">\n                        AIR TRAVEL SERVICES\n                    </div>\n                </td>\n\n                <td style=\"\n                    width: 40%;\n                    text-align: right;\n                    vertical-align: middle;\n                \">\n                    <div style=\"font-size: 18px; font-weight: bold;\">\n                        E-TICKET\n                    </div>\n                    <div style=\"font-size: 11px; color: #777; margin-top: 4px;\">\n                        CONFIRMED BOOKING\n                    </div>\n                </td>\n            </tr>\n        </table>\n    </div>\n\n\n    <!-- PASSENGER -->\n    <div style=\"padding: 20px 28px 10px 28px;\">\n\n        <div style=\"\n            font-size: 10px;\n            color: #777;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n        \">\n            Passenger\n        </div>\n\n        <div style=\"\n            font-size: 21px;\n            font-weight: bold;\n            margin-top: 5px;\n        \">\n            {{ doc.passenger }}\n        </div>\n\n    </div>\n\n\n    <!-- FLIGHT INFORMATION -->\n    <div style=\"\n        margin: 10px 28px;\n        padding: 18px;\n        background: #f7f7f7;\n        border-radius: 8px;\n    \">\n\n        <div style=\"\n            font-size: 10px;\n            color: #777;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            margin-bottom: 8px;\n        \">\n            Flight\n        </div>\n\n        <div style=\"\n            font-size: 17px;\n            font-weight: bold;\n        \">\n            {{ doc.flight }}\n        </div>\n\n    </div>\n\n\n    <!-- TICKET DETAILS -->\n    <div style=\"padding: 10px 28px 20px 28px;\">\n\n        <table style=\"\n            width: 100%;\n            border-collapse: collapse;\n        \">\n\n            <tr>\n\n                <td style=\"\n                    width: 25%;\n                    padding: 12px 10px 12px 0;\n                    border-bottom: 1px solid #eee;\n                \">\n                    <div style=\"font-size: 10px; color: #777;\">\n                        SEAT\n                    </div>\n\n                    <div style=\"\n                        font-size: 19px;\n                        font-weight: bold;\n                        margin-top: 4px;\n                    \">\n                        {{ doc.seat }}\n                    </div>\n                </td>\n\n\n                <td style=\"\n                    width: 25%;\n                    padding: 12px 10px;\n                    border-bottom: 1px solid #eee;\n                \">\n                    <div style=\"font-size: 10px; color: #777;\">\n                        STATUS\n                    </div>\n\n                    <div style=\"\n                        font-size: 16px;\n                        font-weight: bold;\n                        margin-top: 4px;\n                    \">\n                        {{ doc.status }}\n                    </div>\n                </td>\n\n\n                <td style=\"\n                    width: 25%;\n                    padding: 12px 10px;\n                    border-bottom: 1px solid #eee;\n                \">\n                    <div style=\"font-size: 10px; color: #777;\">\n                        FLIGHT PRICE\n                    </div>\n\n                    <div style=\"\n                        font-size: 16px;\n                        font-weight: bold;\n                        margin-top: 4px;\n                    \">\n                        {{ doc.flight_price }}\n                    </div>\n                </td>\n\n\n                <td style=\"\n                    width: 25%;\n                    padding: 12px 0 12px 10px;\n                    border-bottom: 1px solid #eee;\n                \">\n                    <div style=\"font-size: 10px; color: #777;\">\n                        TOTAL\n                    </div>\n\n                    <div style=\"\n                        font-size: 16px;\n                        font-weight: bold;\n                        margin-top: 4px;\n                    \">\n                        {{ doc.total_amount }}\n                    </div>\n                </td>\n\n            </tr>\n\n        </table>\n\n    </div>\n\n\n    <!-- TEAR LINE -->\n    <div style=\"\n        border-top: 2px dashed #ccc;\n        margin: 0 28px;\n    \"></div>\n\n\n    <!-- FOOTER -->\n    <div style=\"\n        padding: 18px 28px 22px 28px;\n        text-align: center;\n    \">\n\n        <div style=\"\n            font-size: 13px;\n            font-weight: bold;\n        \">\n            Your ticket has been successfully booked.\n        </div>\n\n        <div style=\"\n            font-size: 11px;\n            color: #777;\n            margin-top: 6px;\n        \">\n            Thank you for choosing AirStar.\n            Have a safe journey!\n        </div>\n\n    </div>\n\n</div>",
